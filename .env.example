# Copy to .env next to compose.yaml on the server (chmod 600). Every secret lives here;
# museum.yaml holds only the settings that aren't secret. Back this file up: without the two
# ENTE_KEY_ values, museum can't find or read the accounts' emails, so nobody can log in.
# A value containing $ goes in single quotes, e.g. ENTE_SMTP_PASSWORD='pa$$word'.

# PostgreSQL's password, used by both postgres and museum: openssl rand -hex 24
ENTE_DB_PASSWORD=

# museum's own keys. Make each once and never change them.
# openssl rand -base64 32
ENTE_KEY_ENCRYPTION=
# openssl rand -base64 64 | tr -d '\n'
ENTE_KEY_HASH=
# openssl rand -base64 32 | tr '+/' '-_'
ENTE_JWT_SECRET=

# The bucket's access key, limited to that one bucket with read and write.
# Backblaze: the application key's keyID and applicationKey (shown once).
# Hetzner: the S3 credentials' access key and secret key.
ENTE_S3_B2_EU_CEN_KEY=
ENTE_S3_B2_EU_CEN_SECRET=

# The password of the mailbox in museum.yaml's smtp section.
ENTE_SMTP_PASSWORD=

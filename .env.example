# Copy to .env next to compose.yaml on the server (chmod 600) and fill it in. Everything that
# differs from one server to another lives here; museum.yaml holds what doesn't. compose hands
# these to museum under the same names: ENTE_SMTP_HOST is smtp.host in Ente's docs,
# ENTE_S3_B2_EU_CEN_BUCKET is s3.b2-eu-cen.bucket.
#
# Back this file up: without the two ENTE_KEY_ values, museum can't find or read the
# accounts' emails, so nobody can log in. After changing it, run docker compose up -d.
# Keep every value in single quotes: what's inside is taken exactly as written, $ and #
# included. The one thing a value can't contain is a ' itself.

# The server's domain, the same as DOMAIN in /srv/edge/.env (Caddy's). Ente is served at
# photos., api.photos., albums. and embed.<DOMAIN>, as caddy/Caddyfile says. E.g. prabuddh.in
DOMAIN=''

# PostgreSQL's password, used by both postgres and museum: openssl rand -hex 24
# Set it before the first start: PostgreSQL keeps the one it started with. To change it
# later, change it in PostgreSQL first, then here, then docker compose up -d:
#   docker compose exec postgres psql -U pguser -d ente_db -c '\password pguser'
ENTE_DB_PASSWORD=''

# museum's own keys. Make each once and never change them.
# openssl rand -base64 32
ENTE_KEY_ENCRYPTION=''
# openssl rand -base64 64 | tr -d '\n'
ENTE_KEY_HASH=''
# openssl rand -base64 32 | tr '+/' '-_'
ENTE_JWT_SECRET=''

# The bucket. "b2-eu-cen" is a name hardcoded in Ente for the primary bucket and saved next to
# every file in the database: keep it, whichever provider holds the bucket. Moving to another
# one means copying the bucket's contents across, then changing these five.
# The endpoint goes without https://, as Ente's docs write it; the region is its middle part.
# The key is limited to that one bucket, with read and write.
#   Backblaze: the bucket's page shows the endpoint, e.g. s3.eu-central-003.backblazeb2.com
#     (region eu-central-003); the key is an application key's keyID and applicationKey.
#   Hetzner: fsn1.your-objectstorage.com, or nbg1 or hel1 (region fsn1 and so on); the key
#     is the S3 credentials' access key and secret key.
ENTE_S3_B2_EU_CEN_ENDPOINT=''
ENTE_S3_B2_EU_CEN_REGION=''
ENTE_S3_B2_EU_CEN_BUCKET=''
ENTE_S3_B2_EU_CEN_KEY=''
ENTE_S3_B2_EU_CEN_SECRET=''

# Email, for sign-up and login codes. Optional: with no host, museum sends nothing.
# Port 587 (the default) with encryption left empty: museum connects and upgrades with
# STARTTLS, and refuses to send the password if that upgrade fails. Not 465 with "ssl":
# Hetzner Cloud blocks outgoing 465 (and 25) by default.
# The host, e.g. smtp.hostinger.com
ENTE_SMTP_HOST=''
# ENTE_SMTP_PORT='587'
# ENTE_SMTP_ENCRYPTION=''
# The mailbox and its password; mail is sent from the same address. E.g. photos@prabuddh.in
ENTE_SMTP_USERNAME=''
ENTE_SMTP_PASSWORD=''
ENTE_SMTP_EMAIL=''
# ENTE_SMTP_SENDER_NAME='Photos'

# With email working, anyone who finds the site can sign up and fill your bucket. Set this
# to true once your accounts exist; back to false for a moment to add someone.
ENTE_INTERNAL_DISABLE_REGISTRATION='false'
# Who may use the admin CLI: one user ID. Without it, the first account to sign up is admin.
# ENTE_INTERNAL_ADMIN=''
